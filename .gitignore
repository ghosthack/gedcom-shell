target/
.idea/
*.iml
.vscode/
.DS_Store
# private family files: name them *.private.ged (or list them in .git/info/exclude)
*.private.ged

# chart output and saved pictures, wherever they land (chart -o NAME.html/.png/.svg, Save as PDF)
*.html
*.png
*.svg
*.zip
*.pdf
*.jpg
*.jpeg
# ...except test fixtures, which may need to be committed (extension by extension, so
# private .ged files stay ignored)
!/src/test/resources/**/*.html
!/src/test/resources/**/*.png
!/src/test/resources/**/*.svg
!/src/test/resources/**/*.zip
!/src/test/resources/**/*.pdf
!/src/test/resources/**/*.jpg
!/src/test/resources/**/*.jpeg
